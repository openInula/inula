# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=server.py

# Server Configuration  
SERVER_PORT=5000
HOST=localhost

# DeepSeek 配置  
DEEPSEEK_API_KEY=your_deepseek_api_key_here

DEEPSEEK_MODEL=deepseek-chat

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH}

# Logging
LOG_LEVEL=DEBUG
